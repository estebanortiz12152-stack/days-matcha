<title>Day's Matcha</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Zen+Maru+Gothic:wght@500;700;900&family=Caveat:wght@600&display=swap">
<style>
/* Layout: póster pastel a rayas → menú en tarjetas tipo vaso → carrito lateral/hoja inferior → pedido por WhatsApp */
:root{
  --cream:#F5EFE3; --pink:#F4BCD6; --pink-soft:#FBE3EE; --blue:#1D4FA6; --blue-ink:#163C80;
  --matcha:#5E8A2E; --matcha-deep:#1F4A33; --mango:#F4B323; --straw:#E2546B;
  --card:#FFFDF8; --line:rgba(29,79,166,.18); --fg:#1B2A4A; --muted:#5D6A86; color-scheme:light; --field:#F3ECE0; --field-line:rgba(29,79,166,.22); --ease:cubic-bezier(.23,1,.32,1);
  --display:"Bagel Fat One","Arial Rounded MT Bold",system-ui,sans-serif;
  --body:"Zen Maru Gothic","Hiragino Maru Gothic Pro",system-ui,sans-serif;
  --hand:"Caveat","Segoe Print",cursive;
}
*{box-sizing:border-box}
body{background:repeating-linear-gradient(90deg,var(--pink-soft) 0 56px,var(--cream) 56px 112px);color:var(--fg);font-family:var(--body);font-size:16px;line-height:1.5;overflow-x:hidden}
.wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--display);font-weight:400;line-height:1;text-wrap:balance;margin:0}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}

/* top bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--cream)}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--cream) 88%,transparent);backdrop-filter:blur(8px);border-bottom:2px dashed var(--line)}
.bar .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px}
.mini{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--blue)}
.mini svg{width:40px;height:40px}
.mini b{font-family:var(--display);font-size:22px;font-weight:400}
.cartbtn{position:fixed;z-index:30;right:max(18px,calc(env(safe-area-inset-right,0px) + 18px));bottom:calc(18px + env(safe-area-inset-bottom,0px));width:76px;height:76px;justify-content:center;display:flex;align-items:center;background:var(--blue);color:#fff;border:3px solid #fff;border-radius:50%;padding:0;box-shadow:4px 4px 0 var(--pink),0 10px 24px rgba(29,79,166,.35);animation:fabIn .8s 1.2s cubic-bezier(.3,1.6,.5,1) both;font-weight:900;font-size:15px}
.cartbtn svg{width:50px;height:38px}.cartbtn .count{position:absolute;top:-6px;right:-6px;border:2px solid #fff}
.cartbtn.bump{animation:bump .5s}
@keyframes bump{30%{transform:scale(1.2) rotate(-10deg)}60%{transform:scale(.95) rotate(6deg)}}
@keyframes fabIn{from{transform:translateY(120px) rotate(-30deg)}}
.count{background:var(--pink);color:var(--blue-ink);border-radius:999px;min-width:24px;height:24px;display:grid;place-items:center;font-size:13px;padding:0 6px}

/* hero */
.hero{background:transparent;border-bottom:3px solid var(--blue);position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:center;padding-block:48px 56px}
.jp{font-size:20px;font-weight:900;color:var(--blue);letter-spacing:.2em}
.logo-word{font-family:var(--display);color:var(--blue);font-size:clamp(64px,13vw,150px);line-height:.82;margin:6px 0 4px;
  text-shadow:4px 4px 0 var(--pink),8px 8px 0 color-mix(in srgb,var(--blue) 25%,transparent)}
.tag{font-family:var(--hand);font-size:30px;color:var(--straw);transform:rotate(-3deg);display:inline-block}
.lead{max-width:44ch;color:var(--muted);font-weight:500;font-size:17px;margin:14px 0 22px}
.cta{display:flex;flex-wrap:wrap;gap:10px}
.btn:focus-visible,.add:focus-visible,.tab:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
.menu{scroll-margin-top:70px}
.hours{scroll-margin-top:70px}
.lead{text-wrap:pretty}
.btn{border:2.5px solid var(--blue);background:var(--blue);color:var(--cream);border-radius:999px;padding:12px 22px;font-weight:900;font-size:16px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:transform .15s}
.btn.ghost{background:transparent;color:var(--blue)}
.btn:hover{transform:translateY(-2px) rotate(-1deg)}
.hero-art{position:relative;display:grid;place-items:center;padding-top:44px}
.stamp{width:min(100%,360px);aspect-ratio:1;max-width:100%;background:var(--pink);border-radius:50%;display:grid;place-items:center;
  -webkit-mask:radial-gradient(circle at 50% 50%,#000 64%,transparent 64.5%),conic-gradient(#000 0 0);
  clip-path:polygon(50% 0,61% 4%,72% 2%,79% 11%,90% 13%,92% 25%,99% 33%,96% 45%,100% 55%,94% 65%,95% 77%,85% 82%,80% 93%,68% 93%,58% 100%,48% 96%,37% 100%,29% 92%,17% 91%,13% 80%,3% 73%,5% 61%,0 50%,5% 39%,2% 27%,11% 21%,13% 9%,25% 8%,33% 1%,43% 4%)}
.stamp{animation:pop .7s cubic-bezier(.3,1.6,.5,1) both}
.stamp svg{width:72%;height:auto;animation:arrive 1.3s cubic-bezier(.25,1.4,.5,1) .35s both,bob 4s ease-in-out 1.8s infinite}
@keyframes pop{from{transform:scale(.3) rotate(-25deg);opacity:0}}
@keyframes arrive{0%{transform:translateY(-140%) rotate(-20deg);opacity:0}55%{transform:translateY(6%) rotate(8deg) scaleY(.9);opacity:1}75%{transform:translateY(-6%) rotate(-5deg)}100%{transform:none}}
.logo-word{animation:rise .8s .15s cubic-bezier(.3,1.4,.5,1) both}
@keyframes rise{from{transform:translateY(30px);opacity:0}}
@keyframes bob{50%{transform:translateY(-8px) rotate(2deg)}}
.bubble{position:absolute;top:-4px;left:50%;z-index:2;background:var(--card);color:var(--blue);border:2.5px solid var(--blue);border-radius:18px;padding:8px 14px;font-family:var(--hand);font-size:24px;line-height:1;white-space:nowrap;box-shadow:3px 3px 0 var(--pink);transform:translateX(-50%) rotate(-3deg);animation:bubIn .5s 1.5s var(--ease) both}
.bubble::after{content:"";position:absolute;left:50%;bottom:-11px;width:16px;height:16px;background:var(--card);border-right:2.5px solid var(--blue);border-bottom:2.5px solid var(--blue);transform:translateX(-50%) rotate(45deg)}
.bubble.swap{animation:bubSwap .4s var(--ease)}
@keyframes bubIn{from{opacity:0;transform:translateX(-50%) translateY(10px) scale(.9)}}
@keyframes bubSwap{40%{transform:translateX(-50%) rotate(3deg) scale(1.08)}}
.stamp{cursor:pointer}
.sticker{position:absolute;background:var(--card);border:2.5px solid var(--blue);color:var(--blue);border-radius:14px;padding:8px 12px;font-weight:900;font-size:14px;box-shadow:4px 4px 0 var(--blue)}
.sticker.s1{top:6%;left:0;transform:rotate(-8deg)}
.sticker.s2{bottom:8%;right:0;transform:rotate(6deg)}
.sticker span{font-family:var(--hand);font-size:22px;color:var(--straw);display:block;line-height:1}

/* info strip */
.strip{background:var(--blue);color:var(--cream);overflow:hidden;white-space:nowrap;padding-block:12px;font-weight:900;letter-spacing:.08em}
.strip div{display:inline-block;animation:slide 30s linear infinite}
@keyframes slide{to{transform:translateX(-50%)}}

/* menu */
.menu{padding-block:56px 32px}
.head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:16px;margin-bottom:24px}
.head h2{font-size:clamp(44px,8vw,80px);color:var(--matcha-deep)}
.head h2 small{display:block;font-family:var(--hand);font-size:28px;color:var(--straw);transform:rotate(-2deg);margin-bottom:6px}
.tabs{display:flex;flex-wrap:wrap;gap:8px}
.tab{border:2px solid var(--blue);background:transparent;color:var(--blue);border-radius:999px;min-height:42px;padding:0 18px;transition:transform .14s var(--ease),background .2s,color .2s;font-weight:900;font-size:14px}
.tab:hover{background:var(--pink-soft)}
.tab[aria-pressed="true"]{background:var(--blue);color:var(--cream)}
.note{display:flex;gap:10px;align-items:center;background:var(--pink-soft);border:2px dashed var(--pink);border-radius:16px;padding:12px 16px;font-weight:700;color:var(--blue-ink);font-size:14px;margin-bottom:28px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px}
.item{animation:cardIn .6s cubic-bezier(.3,1.4,.5,1) backwards;animation-delay:calc(var(--i)*70ms);background:var(--card);border:2.5px solid var(--blue);border-radius:22px;padding:18px;display:flex;flex-direction:column;gap:12px;box-shadow:6px 6px 0 var(--pink);transition:transform .15s,box-shadow .15s}
.item:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--pink)}
.photo{aspect-ratio:4/5;max-width:100%;border-radius:16px;overflow:hidden;background:var(--pink-soft);border:2px solid var(--line);display:grid;place-items:center;text-align:center;color:var(--blue);font-weight:900;font-size:13px}
.photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.item:hover .photo img{transform:scale(1.06) rotate(-2deg)}
@keyframes cardIn{from{transform:translateY(24px) scale(.96)}}
.add:active,.tab:active,.ex button:active,.opt button:active,.qty button:active,.btn:active{transform:scale(.97)}
.add.done{animation:bump .5s}
.fly{position:fixed;z-index:80;width:44px;height:44px;border-radius:50%;object-fit:cover;border:3px solid var(--blue);pointer-events:none;transition:transform .7s cubic-bezier(.5,-.3,.7,1),opacity .7s}
.doodle{position:absolute;color:var(--blue);opacity:.8;animation:float 5s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-12px) rotate(8deg)}}
.photo svg{width:90px;display:block;margin:0 auto 6px}
.tagline{font-family:var(--hand);font-size:22px!important;color:var(--straw)!important;line-height:1.1;flex:0!important}
.block{display:grid;gap:6px}
.block>i{font-style:normal;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.ing{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.ing button{width:100%;text-align:left;display:flex;align-items:center;gap:8px;background:transparent;border:0;min-height:34px;padding:2px 0;font-family:var(--display);font-size:16px;font-weight:400;letter-spacing:.01em;color:var(--blue)}
.ing button::before{content:"✓";display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--pink);color:var(--blue);border:2px solid var(--blue);font-family:var(--body);font-weight:900;font-size:11px;flex:none;transition:transform .25s cubic-bezier(.3,1.6,.5,1)}
.ing button[aria-pressed="false"]{color:var(--muted);text-decoration:line-through wavy var(--straw)}
.ing button[aria-pressed="false"]::before{content:"✕";background:var(--straw);transform:rotate(90deg)}
.ex{display:flex;flex-wrap:wrap;gap:6px}
.ex button{border:2px dashed var(--matcha-deep);background:transparent;color:var(--matcha-deep);border-radius:999px;min-height:36px;padding:0 12px;font-weight:900;font-size:12.5px}
.ex button{position:relative;transition:transform .15s}
.ex button.pop{animation:exPop .45s cubic-bezier(.3,1.8,.5,1)}
@keyframes exPop{30%{transform:scale(1.18) rotate(-4deg)}60%{transform:scale(.94) rotate(3deg)}}
.spark{position:fixed;z-index:80;pointer-events:none;font-size:14px;animation:spark .7s ease-out forwards}
@keyframes spark{to{transform:translate(var(--dx),var(--dy)) scale(.3) rotate(120deg);opacity:0}}
.ex button b{font-weight:900;opacity:.75}
.ex button[aria-pressed="true"]{background:var(--matcha-deep);color:var(--cream);border-style:solid}
.opt{display:flex;flex-wrap:wrap;gap:6px}
.opt button{border:2px solid var(--blue);background:transparent;color:var(--blue);border-radius:999px;min-height:36px;padding:0 14px;transition:transform .14s var(--ease),background .2s;font-weight:900;font-size:13px}
.opt button[aria-pressed="true"]{background:var(--pink);border-color:var(--blue)}
.opt button.pop{animation:exPop .45s cubic-bezier(.3,1.8,.5,1)}
.opt i{font-style:normal;font-size:12px;font-weight:900;color:var(--muted);width:100%}
.item h3{font-size:26px;letter-spacing:-.01em;color:var(--blue)}
.item .row{padding-top:12px;border-top:2px dashed var(--line)}
.item p{margin:0}
.item .row{margin-top:auto}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.price{font-family:var(--display);font-size:30px;letter-spacing:-.01em;color:var(--matcha-deep);font-variant-numeric:tabular-nums}
.add{border:0;background:var(--matcha-deep);color:var(--cream);border-radius:999px;min-height:44px;padding:0 18px;font-weight:900;font-size:14px;transition:transform .14s var(--ease),background .2s}
.add:hover{background:var(--blue)}
.add:disabled{opacity:.5;cursor:not-allowed}
.wa:hover{filter:brightness(1.06)}
.x:hover{background:var(--pink-soft)}
.x{transition:background .2s,transform .14s var(--ease)}
.x:active{transform:scale(.94)}
.badge{align-self:flex-start;background:var(--mango);color:#3a2600;font-size:12px;font-weight:900;border-radius:999px;padding:3px 10px}

/* horario */
.hours{padding-block:40px 72px}
.hcard{background:repeating-linear-gradient(90deg,color-mix(in srgb,var(--matcha) 18%,var(--cream)) 0 48px,var(--cream) 48px 96px);border:3px solid var(--matcha-deep);border-radius:28px;padding:32px clamp(16px,4vw,48px);display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center}
.hcard h2{font-size:clamp(48px,9vw,96px);color:var(--matcha-deep)}
.hcard h2 small{display:block;font-size:.38em;margin-bottom:6px}
.slots{display:grid;gap:14px}
.slot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 16px;align-items:center;background:var(--card);border-radius:14px;padding:14px 18px;border:2px solid var(--matcha-deep)}
.slot b{background:var(--matcha-deep);color:var(--cream);padding:4px 12px;border-radius:8px;font-size:14px;letter-spacing:.06em}
.slot span{font-weight:900;font-size:20px;color:var(--matcha-deep);font-variant-numeric:tabular-nums}
.rest{letter-spacing:.3em;font-weight:900;color:var(--matcha-deep);font-size:13px;text-align:center}
.bye{display:grid;justify-items:center;gap:8px;text-align:center;padding:24px 16px 48px}
.byecat{width:170px;animation:bob 4s ease-in-out infinite}
.byetxt{margin:0;font-family:var(--display);font-size:clamp(32px,6vw,48px);color:var(--blue);line-height:1}
.byesub{margin:0 0 8px;font-family:var(--hand);font-size:26px;color:var(--straw)}
footer{border-top:2px dashed var(--line);padding-block:28px 110px;background:var(--cream);color:var(--muted);font-size:14px}
footer .wrap{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}

/* drawer */
.scrim{position:fixed;inset:0;background:rgba(20,33,61,.45);z-index:40}
.drawer{position:fixed;z-index:50;top:0;right:0;bottom:0;width:min(440px,100%);background:var(--cream);border-left:3px solid var(--blue);display:flex;flex-direction:column;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);padding-right:env(safe-area-inset-right,0px);transform:translateX(105%);transition:transform .38s var(--ease);box-shadow:-12px 0 40px rgba(29,79,166,.18)}
.drawer.open{transform:none}
.dhead{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:2px dashed var(--line)}
.dhead h2{font-size:34px;color:var(--blue)}
.x{border:2px solid var(--blue);background:transparent;color:var(--blue);width:40px;height:40px;border-radius:50%;font-size:20px;font-weight:900}
.dbody{flex:1;overflow:auto;padding:16px 20px;display:grid;gap:14px;align-content:start}
.line{display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:6px 12px;background:var(--card);border:2px solid var(--line);border-radius:16px;padding:12px 14px}
.line h4{margin:0;font-size:16px;color:var(--blue)}
.line small{color:var(--muted);font-weight:500;grid-column:2;font-size:12.5px;line-height:1.35}
.line img{grid-row:1/3;width:52px;height:64px;object-fit:cover;border-radius:10px;outline:1px solid rgba(0,0,0,.1);outline-offset:-1px}
.line{animation:cardIn .35s var(--ease) backwards}
.qty{display:flex;align-items:center;gap:6px;grid-column:3;grid-row:1/3;align-self:center}
.qty button{width:36px;height:36px;font-size:16px;border-radius:50%;border:2px solid var(--blue);background:transparent;color:var(--blue);font-weight:900}
.qty output{min-width:18px;text-align:center;font-weight:900;font-variant-numeric:tabular-nums}
.empty{text-align:center;color:var(--muted);padding:32px 8px;font-weight:700}
.empty svg{width:110px;margin:0 auto 8px;display:block}
fieldset{border:0;padding:0;margin:0;display:grid;gap:10px}
legend{font-family:var(--display);font-size:22px;color:var(--matcha-deep);margin-bottom:6px}
label{font-size:13px;font-weight:900;color:var(--blue-ink);display:grid;gap:4px}
input,textarea,select{font:inherit;font-size:16px;min-height:46px;border:2px solid var(--field-line);background:var(--field);color:var(--fg);border-radius:12px;padding:10px 12px;width:100%}
input:focus,textarea:focus,select:focus{border-color:var(--blue);background:var(--card);outline:none;box-shadow:0 0 0 4px rgba(244,188,214,.7)}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.seg label{display:block}
.seg input{position:absolute;opacity:0;width:1px}
.seg span{display:block;text-align:center;border:2px solid var(--blue);border-radius:12px;padding:10px;color:var(--blue);font-size:14px}
.seg input:checked+span{background:var(--blue);color:var(--cream)}
.seg input:focus-visible+span{outline:3px solid var(--pink)}
.dfoot{padding:16px 20px;border-top:2px dashed var(--line);display:grid;gap:10px}
.total{display:flex;justify-content:space-between;align-items:baseline}
.total b{font-family:var(--display);font-size:32px;color:var(--matcha-deep);font-weight:400;font-variant-numeric:tabular-nums}
.wa{background:#1FA855;border:0;color:#fff;border-radius:999px;padding:15px;font-weight:900;font-size:17px;display:flex;justify-content:center;align-items:center;gap:10px;text-decoration:none}
.wa[aria-disabled="true"]{opacity:.45;pointer-events:none}
.ship{margin:0;font-size:12.5px;font-weight:700;color:var(--muted)}
.thanks{position:fixed;z-index:75;left:50%;top:50%;transform:translate(-50%,-50%);width:min(340px,calc(100% - 32px));background:var(--cream);border:3px solid var(--blue);border-radius:26px;box-shadow:8px 8px 0 var(--pink);padding:24px;display:grid;gap:8px;text-align:center;justify-items:center;animation:sheetIn .4s var(--ease)}
.thanks svg{width:110px;animation:arrive 1s var(--ease) both}
.thanks b{font-family:var(--display);font-weight:400;font-size:28px;color:var(--blue);line-height:1}
.thanks span{color:var(--muted);font-weight:700;font-size:14px}
.confetti{position:fixed;z-index:76;top:-20px;pointer-events:none;font-size:18px;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(540deg)}}
.zzz{font-family:var(--hand);font-size:28px;color:var(--blue);text-align:center;margin:0;animation:float 3s ease-in-out infinite}
.closed{margin:0;background:var(--pink-soft);border:2px dashed var(--straw);border-radius:12px;padding:8px 12px;font-size:13px;font-weight:700;color:var(--blue-ink)}
.photo.broken{font-size:12px}
.line h4{overflow-wrap:anywhere}
.mapnote{margin:0;padding:10px 16px;background:var(--pink-soft);color:var(--blue-ink);font-weight:700;font-size:13px;text-align:center}
.err{color:var(--straw);font-weight:700;font-size:13px;margin:0}

/* modal opciones */
.modal{position:fixed;z-index:60;left:50%;top:50%;transform:translate(-50%,-50%);width:min(460px,calc(100% - 32px));background:var(--cream);border:3px solid var(--blue);border-radius:26px;box-shadow:8px 8px 0 var(--pink);display:flex;flex-direction:column;max-height:88vh;overflow:hidden;animation:sheetIn .35s var(--ease)}
@keyframes sheetIn{from{transform:translate(-50%,-46%) scale(.96);opacity:0}}
.mhead{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center;padding:16px 18px;border-bottom:2px dashed var(--line)}
.mhead img{width:64px;height:80px;object-fit:cover;border-radius:12px;outline:1px solid rgba(0,0,0,.1);outline-offset:-1px}
.mhead h3{font-size:26px;color:var(--blue)}
#mOpts{overflow:auto;padding:16px 18px;display:grid;gap:18px}
.mfoot{padding:14px 18px calc(14px + env(safe-area-inset-bottom,0px));border-top:2px dashed var(--line)}
.mfoot .btn:focus-visible,.add:focus-visible,.tab:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
.menu{scroll-margin-top:70px}
.hours{scroll-margin-top:70px}
.lead{text-wrap:pretty}
.btn{width:100%;justify-content:center;min-height:52px}
#mPrice{font-variant-numeric:tabular-nums}
.mini-ing{font-size:13px!important;font-weight:700;color:var(--muted)}
button.photo{padding:0;cursor:pointer;position:relative}
.hint{position:absolute;left:10px;bottom:10px;z-index:1;background:var(--card);color:var(--blue);border:2px solid var(--blue);border-radius:999px;padding:4px 10px;font-size:12px;font-weight:900;box-shadow:2px 2px 0 var(--pink);transition:transform .2s var(--ease)}
.item:hover .hint{transform:translateY(-3px) rotate(-2deg)}
.custom{display:flex;flex-wrap:wrap;gap:6px;background:transparent;border:0;padding:0;text-align:left}
.custom span{border:2px dashed var(--blue);color:var(--blue);border-radius:999px;padding:4px 10px;font-size:12px;font-weight:900;transition:background .2s,transform .14s var(--ease)}
.custom:hover span{background:var(--pink-soft)}
.custom:active span{transform:scale(.97)}
@media (max-width:600px){.modal{left:0;right:0;bottom:0;top:auto;width:100%;transform:none;border-radius:26px 26px 0 0;border-width:3px 0 0;max-height:90vh;animation:sheetUp .38s var(--ease)}
 @keyframes sheetUp{from{transform:translateY(100%)}}}
.modal h3{font-size:30px;color:var(--blue)}
.toast{position:fixed;z-index:70;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--matcha-deep);color:var(--cream);padding:12px 20px;border-radius:999px;font-weight:900}

@media (max-width:760px){
  .hero .wrap,.hcard{grid-template-columns:1fr}
  .hero-art{order:-1}.stamp{width:240px}
  .bubble{position:absolute;top:-4px;left:50%;z-index:2;background:var(--card);color:var(--blue);border:2.5px solid var(--blue);border-radius:18px;padding:8px 14px;font-family:var(--hand);font-size:24px;line-height:1;white-space:nowrap;box-shadow:3px 3px 0 var(--pink);transform:translateX(-50%) rotate(-3deg);animation:bubIn .5s 1.5s var(--ease) both}
.bubble::after{content:"";position:absolute;left:50%;bottom:-11px;width:16px;height:16px;background:var(--card);border-right:2.5px solid var(--blue);border-bottom:2.5px solid var(--blue);transform:translateX(-50%) rotate(45deg)}
.bubble.swap{animation:bubSwap .4s var(--ease)}
@keyframes bubIn{from{opacity:0;transform:translateX(-50%) translateY(10px) scale(.9)}}
@keyframes bubSwap{40%{transform:translateX(-50%) rotate(3deg) scale(1.08)}}
.stamp{cursor:pointer}
.sticker{font-size:12px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.pin{display:flex;gap:12px;align-items:center;text-align:left;border:2.5px dashed var(--blue);background:var(--card);border-radius:16px;padding:12px 14px;color:var(--blue)}
.pin.set{border-style:solid;background:var(--pink-soft)}
.pinico{font-size:26px;animation:float 3s ease-in-out infinite}
.pin small{display:block;color:var(--muted);font-weight:500;font-size:12px}
.mapbox{position:fixed;z-index:65;inset:0;background:var(--cream);display:flex;flex-direction:column;padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px)}
.mapbar{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 16px;border-bottom:3px solid var(--blue)}
.mapbar h3{font-size:24px;color:var(--blue)}
#map{flex:1;background:var(--pink-soft)}
.mapfoot{display:grid;gap:8px;padding:12px 16px;border-top:3px solid var(--blue)}
.mapfoot p{margin:0;font-size:13px;color:var(--muted);font-weight:700;text-align:center}
.catpin{font-size:34px;line-height:1;filter:drop-shadow(2px 3px 0 rgba(29,79,166,.35))}
