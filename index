  const key=m.id+"|"+opts.join(",");
  const l=cart.find(x=>x.key===key);
  if(l&&l.q>=MAXQ){toast(`Máximo ${MAXQ} por bebida, escríbenos para pedidos grandes`);return}
  l?l.q++:cart.push({key,id:m.id,opts,q:1,p:unit(m)});
  save();renderCart();toast([`¡${m.name} al carrito! 🍵`,`Buena elección ✦ ${m.name}`,`El gatito aprueba tu ${m.name} 🐱`][Math.floor(Math.random()*3)]);
}
function fly(img){if(!img||matchMedia("(prefers-reduced-motion:reduce)").matches){bump();return}
  const r=img.getBoundingClientRect(),t=$("#openCart").getBoundingClientRect(),c=document.createElement("img");
  c.src=img.src;c.className="fly";c.style.left=(r.left+r.width/2-22)+"px";c.style.top=(r.top+r.height/2-22)+"px";document.body.appendChild(c);
  requestAnimationFrame(()=>{c.style.transform=`translate(${t.left+t.width/2-r.left-r.width/2}px,${t.top+t.height/2-r.top-r.height/2}px) scale(.4)`;c.style.opacity=".3"});
  setTimeout(()=>{c.remove();bump()},700)}
function bump(){const b=$("#openCart");b.classList.remove("bump");void b.offsetWidth;b.classList.add("bump")}
let tt;function toast(t){const el=$("#toast");el.textContent=t;el.hidden=false;clearTimeout(tt);tt=setTimeout(()=>el.hidden=true,1800)}

function renderCart(){
  const n=cart.reduce((a,l)=>a+l.q,0);$("#count").textContent=n;
  if(!cart.length){
    $("#lines").innerHTML=`<div class="empty"><svg viewBox="0 0 200 220"><use href="#cat"/></svg>Tu vaso está vacío.<br>Elige algo rico del menú.</div>`;
  }else{
    $("#lines").innerHTML=`<div style="display:grid;gap:10px">${cart.map((l,i)=>{const m=MENU.find(x=>x.id===l.id);return `
      <div class="line"><img src="${m.img}" alt="" onerror="this.style.visibility='hidden'"><h4>${m.name}</h4>
      <div class="qty"><button data-i="${i}" data-d="-1" aria-label="Quitar uno">−</button><output>${l.q}</output><button data-i="${i}" data-d="1" aria-label="Agregar uno">+</button></div>
      <small>${l.opts.join(" · ")||"&nbsp;"} · ${money(lp(l)*l.q)}</small></div>`}).join("")}</div>`;
  }
  $("#total").textContent=money(total());
  updateLink();
}
const lp=l=>l.p??MENU.find(x=>x.id===l.id).price;
const total=()=>cart.reduce((a,l)=>a+lp(l)*l.q,0);
$("#lines").onclick=e=>{const b=e.target.closest("button[data-i]");if(!b)return;const l=cart[b.dataset.i];if(!l)return;if(+b.dataset.d>0&&l.q>=MAXQ){toast(`Máximo ${MAXQ} por bebida`);return}l.q+=+b.dataset.d;if(l.q<1)cart.splice(b.dataset.i,1);save();renderCart()};

const mode=()=>document.querySelector('input[name="mode"]:checked').value;
function updateLink(){
  const dom=mode()==="domicilio";document.querySelector(".ship").hidden=!dom;$("#addrBox").style.display=dom?"grid":"none";
  const name=$("#name").value.trim(),addr=$("#addr").value.trim();
  const maps=$("#maps").value.trim();let miss=[];if(!cart.length)miss.push("agrega algo al carrito");if(!name)miss.push("escribe tu nombre");if(dom&&addr&&addr.length<8&&!maps)miss.push("agrega calle y número a tu domicilio");const ph=$("#phone").value.replace(/\D/g,"");if(ph&&ph.length!==10&&!(ph.length===12&&ph.startsWith("52")))miss.push("revisa tu teléfono, son 10 dígitos");if(dom&&!addr&&!maps)miss.push("escribe tu domicilio o marca tu ubicación");
  const ok=!miss.length,a=$("#send");a.setAttribute("aria-disabled",String(!ok));
  $("#err").hidden=ok;$("#err").textContent=ok?"":"Para enviar, "+miss.join(", ")+".";
  if(!ok){a.href="#";return}
  const lines=cart.map(l=>{const m=MENU.find(x=>x.id===l.id);return `• ${l.q} x ${m.name}${l.opts.length?" ("+l.opts.join(", ")+")":""} — ${money(lp(l)*l.q)}`});
  const msg=[`Hola Day's Matcha! 🍵 Quiero hacer un pedido`,``,...lines,``,`Total ${money(total())}${dom?" + envío":""}`,``,`Nombre ${name}`,
    $("#phone").value.trim()?`Tel ${$("#phone").value.trim()}`:null,
    dom?`Entrega a domicilio\n${addr}${maps?"\nUbicación "+maps:""}${$("#ref").value.trim()?"\nRef. "+$("#ref").value.trim():""}`:"Paso a recoger",
    `Pago ${$("#pay").value}`,$("#notes").value.trim()?`Notas ${$("#notes").value.trim()}`:null].filter(x=>x!==null).join("\n");
  a.href=`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
}
$("#form").addEventListener("input",updateLink);$("#form").addEventListener("change",updateLink);
$("#form").addEventListener("submit",e=>e.preventDefault());

$("#send").addEventListener("click",e=>{
  if($("#send").getAttribute("aria-disabled")==="true"){e.preventDefault();return}
  if(navigator.onLine===false){e.preventDefault();toast("Sin internet. Conéctate y vuelve a intentar");return}
  if(WHATSAPP==="523221234567")toast("Ojo, aún falta poner el número real del negocio");
  setTimeout(celebrate,400);
});
function celebrate(){
  closeCart();$("#thanks").hidden=false;$("#scrim").hidden=false;$("#thanksOk").focus();
  if(matchMedia("(prefers-reduced-motion:reduce)").matches)return;
  for(let i=0;i<36;i++){const c=document.createElement("span");c.className="confetti";c.textContent=["🍵","♥","✿","✦","🍓","🥭"][i%6];
    c.style.left=Math.random()*100+"vw";c.style.color=["#1D4FA6","#E2546B","#5E8A2E","#F4B323"][i%4];c.style.animationDuration=(1.6+Math.random()*1.6)+"s";c.style.animationDelay=Math.random()*.5+"s";
    document.body.appendChild(c);setTimeout(()=>c.remove(),4000)}
}
$("#thanksOk").onclick=()=>{$("#thanks").hidden=true;$("#scrim").hidden=true;cart=[];save();renderCart()};
const LINES=["¿Un matcha hoy?","¡Ay, me encantas!","Hecho al momento ✦","Prueba el Lotus 🍪","¿Fresa o mango?","Miau… matcha 🍵"];
let li=0;function nextLine(){li=(li+1)%LINES.length;const b=$("#bubble");b.textContent=LINES[li];b.classList.remove("swap");void b.offsetWidth;b.classList.add("swap")}
setInterval(()=>{if(!document.hidden)nextLine()},4200);
$(".stamp").addEventListener("click",()=>{nextLine();const s=$(".stamp svg");s.style.animation="none";void s.offsetWidth;s.style.animation=""});
function openCart(){$("#drawer").inert=false;$("#drawer").classList.add("open");$("#scrim").hidden=false;$("#closeCart").focus()}
function closeCart(){if(!$("#drawer").classList.contains("open"))return;$("#drawer").classList.remove("open");$("#drawer").inert=true;$("#openCart").focus();if($("#modal").hidden)$("#scrim").hidden=true}
$("#openCart").onclick=openCart;$("#closeCart").onclick=closeCart;
$("#scrim").onclick=()=>{if(!$("#thanks").hidden){$("#thanksOk").click();return}closeModal();closeCart()};
addEventListener("keydown",e=>{if(e.key!=="Escape")return;if(!$("#mapbox").hidden){$("#mapbox").hidden=true;$("#pickMap").focus();return}closeModal();closeCart()});

/* abierto / cerrado, siempre con la hora de Vallarta aunque el cliente esté en otro huso */
function isOpen(){
  try{
    const p=Object.fromEntries(new Intl.DateTimeFormat("en-US",{timeZone:"America/Mexico_City",weekday:"short",hour:"numeric",minute:"numeric",hour12:false}).formatToParts(new Date()).map(x=>[x.type,x.value]));
    const day=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].indexOf(p.weekday),h=(+p.hour%24)+(+p.minute)/60;
    if(day===2)return false;if(day>=1&&day<=4)return h>=11&&h<21;return h>=12&&h<22;
  }catch(e){return true}
}
function paintStatus(){const o=isOpen();$("#status").textContent=o?"● ABIERTO AHORA":"○ CERRADO AHORA";$("#status").style.color=o?"var(--matcha)":"var(--straw)";$("#closedNote").hidden=o;$("#zzz").hidden=o}
paintStatus();setInterval(paintStatus,60000);

/* mapa para marcar ubicación (Leaflet + OpenStreetMap) */
let map,marker,picked=null;
const PV=[20.6534,-105.2253];
function openMap(){
  $("#mapbox").hidden=false;
  if(!window.L){$("#mapErr").hidden=false;$("#map").hidden=true;$("#mapOk").hidden=true;$("#myLoc").hidden=true;return}
  if(!map){
    map=L.map("map",{zoomControl:true}).setView(picked||PV,picked?17:13);
    let tileErr=0;L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap"}).on("tileerror",()=>{if(++tileErr===4)$("#mapErr").hidden=false}).addTo(map);
    const icon=L.divIcon({className:"",html:'<div class="catpin">📍</div>',iconSize:[34,34],iconAnchor:[17,32]});
    marker=L.marker(picked||PV,{draggable:true,icon}).addTo(map);
    map.on("click",e=>marker.setLatLng(e.latlng));
  }
  setTimeout(()=>map.invalidateSize(),50);
}
$("#pickMap").onclick=openMap;
$("#mapClose").onclick=()=>{$("#mapbox").hidden=true;$("#pickMap").focus()};
$("#myLoc").onclick=()=>{
  if(!navigator.geolocation){toast("Tu navegador no comparte ubicación");return}
  navigator.geolocation.getCurrentPosition(p=>{const ll=[p.coords.latitude,p.coords.longitude];marker.setLatLng(ll);map.setView(ll,17)},
    ()=>toast("Activa el permiso de ubicación o mueve el pin"),{enableHighAccuracy:true,timeout:10000});
};
$("#mapOk").onclick=()=>{
  if(marker){const ll=marker.getLatLng();picked=[ll.lat,ll.lng];
    $("#maps").value=`https://maps.google.com/?q=${ll.lat.toFixed(6)},${ll.lng.toFixed(6)}`;
    $("#pickMap").classList.add("set");$("#pinTitle").textContent="Ubicación marcada ✓";$("#pinSub").textContent="Toca para cambiarla";}
  $("#mapbox").hidden=true;updateLink();
};

renderTabs();renderGrid();renderCart();
</script>
